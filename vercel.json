{
  "version": 2,
  "builds": [
    {
      "src": "3d-model-transfer-tool/app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "templates/**",
          "*.py"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "3d-model-transfer-tool/app.py"
    }
  ]
}
